# ElevenLabs API Key for Studio-Quality Human Text-to-Speech (TTS)
# Obtain your API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Default Voice ID (defaults to 'pNInz6obpgDQGcFmaJgB' - Adam)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional: Language-Specific Voice ID Overrides
# By default, the system automatically routes languages to fitting premade voices:
# - Greek/Latin/Sanskrit: Daniel (British scholarly orator)
# - Japanese/East Asian: Alice (Clear enunciation)
# - Indonesian/Austronesian: Adam (Deep narrator)
# - Arabic/Near Eastern: George (Warm storyteller)
# - Germanic/Nordic: Bella (Articulate)
# - Romance: Lily (Velvety)
# - Slavic: Eric (Resonant)
#
# If you have paid community library voices or cloned voices, you can set them here:
# ELEVENLABS_VOICE_JAPANESE=TzUI53GPXnGDRdeLAWZ4   # e.g. Toshi
# ELEVENLABS_VOICE_INDONESIAN=1k39YpzqXZn52BgyLyGO # e.g. Bian
# ELEVENLABS_VOICE_GREEK=JrrE7QTGDmQKQuUnqk7H      # e.g. Martha
# ELEVENLABS_VOICE_ARABIC=g3YpdjT1OTh9cunaumJs     # e.g. Layla
# ELEVENLABS_VOICE_CHINESE=4VZIsMPtgggwNg7OXbPY    # e.g. James Gao
# ELEVENLABS_VOICE_LATIN=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_VOICE_GERMAN=hpp4J3VqNfWAUOO0d1Us
# ELEVENLABS_VOICE_FRENCH=pFZP5JQG7iQjIQuC4Bku

# Gemini API Key (for AI Term Generation CLI & prompt engine)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
